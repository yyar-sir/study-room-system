# ============================================================
# 本地开发配置模板
# 用法：复制本文件为同目录下的 application-local.yml 并填写真实值。
#       application-local.yml 已被 .gitignore 忽略，不会提交到仓库。
#       application.yml 中 spring.profiles.active 默认即为 local，
#       因此只要该文件存在就会被自动加载并覆盖基础配置。
# ============================================================

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/ai_enlighten?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: your_db_username
    password: your_db_password

jwt:
  # 生产环境请替换为随机长字符串（>= 32 字符）
  secret: your_jwt_secret_at_least_32_characters_long
  expire-hours: 72
